# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

.output/
.artifacts/
.cache/

temp

sessions/**/outputs

.history/

.timeline_data/
output/
# Generated timeline SVGs should publish into `docs/` (Pages), not under `world/`.
world/**/_history.*.svg
world/**/_timeline.*.svg

# Editor Files
.idea/
*.swp
*.swo
*.bak
*~

# Temporary Files
/tmp/
*.tmp
*.temp

# Personal Notes (if you want to keep private notes)
# Uncomment the following if you want to exclude certain private directories
# /personal-notes/
# /dm-secrets/

# Build artifacts (if using any tools to generate PDFs, etc.)
*.pdf
*.aux
*.log

# Node modules (if using any Node.js tools)
node_modules/
package-lock.json

# Python / uv
.venv/
venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Codex (local)
.codex/config.toml
.codex/config.local.toml

# Local secrets
.env

# Runtime pidfiles/logs for `make vtt-up` (cloudflared) — machine-local
.run/

# Combat-runner per-encounter auto-memory (per-machine state)
combat-runner/.memory/

# Combat-runner scenario-test metrics (per-run output, machine-local)
combat-runner/tests/.metrics/

# Combat-runner testbot per-run output (run JSONs, cron logs, decisions, etc.)
# scenarios.yml is a hand-authored config input — keep it tracked.
# Ignore dir *contents* (not the dir itself) so the negation can re-include the file.
combat-runner/.testbot/*
!combat-runner/.testbot/scenarios.yml

# VTT auto-updater runtime state: the mkdir lock, the phase/status files, the HTTP
# cache, and the core-rollback tars (a full copy of Foundry's app dir, ~287 MB each).
# Machine-local by definition and far too large to track.
.state/

# Built by automation/notifier/build-notifier.sh — a compiled AppleScript bundle
# carrying a copy of Foundry's icon. Rebuilt by `make vtt-notifier`, not tracked.
automation/notifier/*.app/
