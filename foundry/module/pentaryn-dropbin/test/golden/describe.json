  ],
  "patches": [],
  "flags": {
    "writes": [
      "flags.pentaryn-dropbin.corpse",
      "flags.pentaryn-dropbin.sight",
      "flags.pentaryn-dropbin.ownership",
      "flags.item-piles.data.lockedSound"
    ],
    "reads": [
      "flags.item-piles.data"
    ]
  },
  "errors": [
