{
  "module": "pentaryn-attunement",
  "namespace": "attunement",
  "contract": "pentaryn-attunement/api@1",
  "flagScope": "pentaryn-attunement",
  "methods": [
    {
      "path": "report",
      "params": [
        {
          "name": "target",
          "type": "Actor|id|name",
          "optional": true,
          "resolve": false,
          "doc": "defaults to the first controlled token's actor"
        },
        {
          "name": "opts",
          "type": "{ quiet? }",
          "optional": true,
          "doc": "quiet: no console output"
        }
      ],
      "returns": "{ actor, value, max, over, slots, rows } | undefined",
      "gm": false,
      "writes": false,
      "query": false,
      "sideEffects": [
        "console.log",
        "console.table"
      ],
      "nullWhen": "no actor → undefined (console.warn)",
      "legacy": true,
      "doc": "Console audit of one actor: what is attuned, its slot, and source-vs-prepared data issues. Looks a string up by id, then by game.actors.getName (first match)."
    },
    {
      "path": "computeSlots",
      "params": [
        {
          "name": "actor",
          "kind": "actor",
          "type": "Actor|uuid|id|exact name",
          "resolve": false,
          "doc": "an Actor (any object with items and getFlag) passes through unchanged; a string resolves exactly (never a substring)"
        }
      ],
      "returns": "{ slots: (itemId|'away:<key>'|null)[], max, value, over } | null",
      "gm": false,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "nullWhen": "a string that names no actor, or an object that is not actor-like (no items or getFlag)",
      "throws": [
        "AMBIGUOUS"
      ],
      "legacy": true,
      "doc": "The reconciled slot order the strip draws (stored order, holes kept, newcomers in the first hole)."
    },
    {
      "path": "stash",
      "params": [
        {
          "name": "owner",
          "kind": "actor",
          "type": "Actor",
          "resolve": false
        },
        {
          "name": "container",
          "kind": "actor",
          "type": "Actor",
          "resolve": false,
          "doc": "usually an Item Piles container"
        },
        {
          "name": "itemIds",
          "type": "string[]"
        },
        {
          "name": "opts",
          "type": "{ tag?, currency?, detail? }",
          "optional": true,
          "doc": "tag defaults to the owner's first name; currency also moves the coin as a purse; detail resolves { count, created, away } instead of the count"
        }
      ],
      "returns": "Promise<number | { count, created: string[], away: string[] }>",
      "gm": false,
      "writes": true,
      "query": false,
      "sideEffects": [
        "flags.pentaryn-attunement.slots",
        "flags.pentaryn-attunement.away",
        "flags.pentaryn-attunement.bond",
        "container Items (created)",
        "owner Items (deleted)",
        "owner system.currency (with currency)"
      ],
      "legacy": true,
      "doc": "Confiscation: move items into a container, tagged and bonded so they come home attuned; attuned items keep their slot as away entries. Resolves the number of items created. owner and container are live Actor documents (eval-js only)."
    },
    {
      "path": "releaseAway",
      "params": [
        {
          "name": "actor",
          "kind": "actor",
          "type": "Actor",
          "resolve": false
        },
        {
          "name": "key",
          "type": "string"
        }
      ],
      "returns": "Promise<Actor> (setFlag's)",
      "gm": false,
      "writes": true,
      "query": false,
      "sideEffects": [
        "flags.pentaryn-attunement.away"
      ],
      "legacy": true,
      "doc": "End attunement to an away item: drop its away entry (the item comes back unattuned). actor is a live Actor document (eval-js only)."
    },
    {
      "path": "away",
      "params": [
        {
          "name": "actor",
          "kind": "actor",
          "type": "Actor|uuid|id|exact name",
          "resolve": false,
          "doc": "an Actor (any object with items and getFlag) passes through unchanged; a string resolves exactly (never a substring)"
        }
      ],
      "returns": "{ key, name, img }[]",
      "gm": false,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "throws": [
        "AMBIGUOUS"
      ],
      "legacy": true,
      "doc": "The actor's away entries (attuned items not on the actor); [] when there are none or no actor (a string that names no actor, or an object that is not actor-like: no items or getFlag)."
    },
    {
      "path": "inspect",
      "params": [
        {
          "name": "ref",
          "kind": "actor",
          "type": "Actor|Token|uuid|id|exact name",
          "doc": "never a substring"
        },
        {
          "name": "opts",
          "type": "{ sceneId?, base? }",
          "optional": true
        }
      ],
      "returns": "{ actor, slots, max, value, over, away, bonds: [{ item, ...bond }], counts: { dnd5e, away, strip, mismatch } }",
      "gm": false,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "throws": [
        "NOT_FOUND",
        "AMBIGUOUS",
        "BAD_ARGS"
      ],
      "doc": "Read-only attunement state for one actor, plain JSON, depth ≤ 4. counts compares dnd5e's attunement.value (+ away) with the strip's count; mismatch is true when they differ."
    },
    {
      "path": "selftest",
      "params": [],
      "returns": "{ ok, checks: [{ label, ok, detail }] }",
      "gm": false,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "doc": "Live smoke checks after a sync."
    }
  ],
  "queries": [],
  "settings": [],
  "events": [],
  "hooks": [
    {
      "name": "renderBaseActorSheet",
      "label": "renderBaseActorSheet: strip"
    },
    {
      "name": "preUpdateItem",
      "label": "preUpdateItem: over-cap warn"
    },
    {
      "name": "preCreateItem",
      "label": "preCreateItem: bond restore"
    },
    {
      "name": "createItem",
      "label": "createItem: bond return"
    }
  ],
  "patches": [
    {
      "label": "Tooltips5e#_positionItemTooltip",
      "marker": "pentarynGuarded",
      "adjustments": "attunement-item-tooltip-anchor"
    }
  ],
  "flags": {
    "writes": [
      "flags.pentaryn-attunement.slots",
      "flags.pentaryn-attunement.away",
      "flags.pentaryn-attunement.bond",
      "flags.pentaryn-attunement.claims.coinBack",
      "flags.pentaryn-attunement.claims.home"
    ],
    "reads": []
  },
  "errors": [
    "NOT_GM",
    "NO_GM",
    "NOT_READY",
    "NOT_FOUND",
    "AMBIGUOUS",
    "BAD_ARGS",
    "REFUSED",
    "CONFLICT",
    "UNSUPPORTED",
    "TIMEOUT",
    "INTERNAL"
  ]
}
