{
  "id": "pentaryn-importer",
  "title": "Pentaryn Importer",
  "description": "Headless importer for generated Pentaryn NPC Actors (game.pentaryn.import(), see foundry/CONTRACT.md), and DDB corrections: re-applies the table's fixes to D&D Beyond characters after every ddb-importer sync (one world setting, no UI).",
  "version": "1.2.1",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Joseph Atkinson"
    }
  ],
  "esmodules": [
    "pentaryn-importer.mjs"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.0",
          "verified": "6.0.6"
        }
      }
    ]
  },
  "socket": false,
  "protected": false,
  "flags": {
    "pentaryn": {
      "contract": "pentaryn/actors.json@1",
      "targetSystem": "dnd5e",
      "targetSystemVersion": "6.0",
      "generation": 14,
      "defaultFileName": "actors.json",
      "tier": "full",
      "namespace": "importer",
      "flagScope": "pentaryn-importer",
      "cssPrefix": "pim-",
      "afterSync": [
        "The actor pipeline stages this module (make foundry-import), not module-sync.",
        "A module.json change needs a Foundry restart; then, as the GM:",
        "  game.pentaryn.importer.describe().version   await game.pentaryn.importer.selftest()",
        "  await game.pentaryn.import({ dryRun: true })"
      ]
    }
  }
}
