"<div class=\"pentaryn-ties pt-review\"><header class=\"pt-review-head\">\n      <div class=\"pt-review-bar\">\n        <input type=\"search\" class=\"pt-review-search\" placeholder=\"Filter by title, id, category, text…\" value=\"\">\n        <select class=\"pt-review-sort\" aria-label=\"sort\"><option value=\"review\" selected>Needs review first</option><option value=\"title\" >Title</option><option value=\"modified\" >Last modified</option><option value=\"category\" >Category</option></select>\n        <button type=\"button\" class=\"pt-textbtn\" data-act=\"resort\" data-tooltip=\"Rows stay where they are while you work; this re-applies the sort\"><i class=\"fa-solid fa-arrow-down-short-wide\"></i> Re-sort</button>\n      </div>\n      <div class=\"pt-review-bar\">\n        <button type=\"button\" class=\"pt-chip pt-review-tab pt-chip-on\" data-tab=\"world\">Global (<span data-count=\"tab-world\">0</span>)</button><button type=\"button\" class=\"pt-chip pt-review-tab \" data-tab=\"personal\">Personal (<span data-count=\"tab-personal\">0</span>)</button>\n        <span class=\"pt-review-divider\"></span>\n        <button type=\"button\" class=\"pt-chip pt-chip-on\" data-filter=\"all\">All</button>\n        <button type=\"button\" class=\"pt-chip \" data-filter=\"needs\">Needs review (<span data-count=\"needs\">0</span>)</button>\n        <button type=\"button\" class=\"pt-chip \" data-filter=\"selected\">Selected (<span data-count=\"selected\">0</span>)</button>\n        <span class=\"pt-review-spacer\"></span>\n        <button type=\"button\" class=\"pt-textbtn\" data-act=\"select-visible\"><i class=\"fa-regular fa-square-check\"></i> Select visible</button>\n        <button type=\"button\" class=\"pt-textbtn\" data-act=\"select-none\"><i class=\"fa-regular fa-square\"></i> Select none</button>\n        <button type=\"button\" class=\"pt-textbtn\" data-act=\"copy-selected\"><i class=\"fa-regular fa-copy\"></i> Copy selected</button>\n      </div>\n      <p class=\"pt-review-counts\"></p>\n    </header>\n      <ul class=\"pt-review-list\"><li class=\"pt-review-row\" data-id=\"guild\" data-tab=\"world\" data-state=\"unreviewed\" data-needs=\"true\" data-search=\"guild\nsalt guild\nguild\n&lt;p&gt;guild hands.&lt;/p&gt;\n\">\n      <div class=\"pt-review-summary\" data-act=\"toggle\">\n      <input type=\"checkbox\" class=\"pt-review-sel\" data-act=\"select\"  aria-label=\"select\">\n      <img class=\"pt-attr-icon\" src=\"icons/sundries/flags/banner-standard-green.webp\" alt=\"\">\n      <span class=\"pt-review-main\">\n        <span class=\"pt-review-line\"><b class=\"pt-review-title\">Salt Guild</b>\n          <span class=\"pt-review-cat\">Guild</span>\n          <code class=\"pt-review-id\" data-act=\"copy-id\" data-tooltip=\"Copy id\">guild</code></span>\n        <span class=\"pt-review-line pt-review-meta\">\n          <span class=\"pt-review-link pt-review-parent\" data-tooltip=\"Can only be rolled after Vel is identified\"><i class=\"fa-solid fa-lock\"></i> needs Vel</span>\n          \n          <span>0 facts</span>\n          <span>1 carriers</span>\n          <span>modified <span class=\"pt-review-time\" data-tooltip=\"1970-01-01T00:00:00.005Z\">1/1/1970, 12:00:00 AM</span></span>\n          <span class=\"pt-review-badge pt-review-warn\"><i class=\"fa-solid fa-triangle-exclamation\"></i> Not reviewed</span></span>\n      </span>\n      <button type=\"button\" class=\"pt-review-sign\" data-act=\"review\"><i class=\"fa-solid fa-check\"></i> Reviewed</button>\n      <i class=\"fa-solid fa-chevron-down pt-review-caret\"></i>\n    </div></li><li class=\"pt-review-row\" data-id=\"diary\" data-tab=\"personal\" data-state=\"unreviewed\" data-needs=\"true\" data-search=\"diary\ncaven&#x27;s diary\npersonal\n&lt;p&gt;kept a diary.&lt;/p&gt;\n\">\n      <div class=\"pt-review-summary\" data-act=\"toggle\">\n      <input type=\"checkbox\" class=\"pt-review-sel\" data-act=\"select\"  aria-label=\"select\">\n      <img class=\"pt-attr-icon\" src=\"icons/sundries/flags/banner-standard-brown.webp\" alt=\"\">\n      <span class=\"pt-review-main\">\n        <span class=\"pt-review-line\"><b class=\"pt-review-title\">Caven&#x27;s diary</b>\n          <span class=\"pt-review-cat\">personal</span>\n          <code class=\"pt-review-id\" data-act=\"copy-id\" data-tooltip=\"Copy id\">diary</code></span>\n        <span class=\"pt-review-line pt-review-meta\">\n          \n          \n          <span>0 facts</span>\n          <span>1 carriers</span>\n          <span>modified <span class=\"pt-review-time\" data-tooltip=\"Before timestamps were recorded (Oct 2026), or never\">—</span></span>\n          <span class=\"pt-review-badge pt-review-warn\"><i class=\"fa-solid fa-triangle-exclamation\"></i> Not reviewed</span></span>\n      </span>\n      <button type=\"button\" class=\"pt-review-sign\" data-act=\"review\"><i class=\"fa-solid fa-check\"></i> Reviewed</button>\n      <i class=\"fa-solid fa-chevron-down pt-review-caret\"></i>\n    </div></li><li class=\"pt-review-row\" data-id=\"city\" data-tab=\"world\" data-state=\"reviewed\" data-needs=\"false\" data-search=\"city\nvel\ncity\n&lt;p&gt;from vel.&lt;/p&gt;\n&lt;p&gt;an accent.&lt;/p&gt;\nwalls\n&lt;p&gt;three rings.&lt;/p&gt;\n\">\n      <div class=\"pt-review-summary\" data-act=\"toggle\">\n      <input type=\"checkbox\" class=\"pt-review-sel\" data-act=\"select\"  aria-label=\"select\">\n      <img class=\"pt-attr-icon\" src=\"icons/environment/settlement/city-night.webp\" alt=\"\">\n      <span class=\"pt-review-main\">\n        <span class=\"pt-review-line\"><b class=\"pt-review-title\">Vel</b>\n          <span class=\"pt-review-cat\">City</span>\n          <code class=\"pt-review-id\" data-act=\"copy-id\" data-tooltip=\"Copy id\">city</code></span>\n        <span class=\"pt-review-line pt-review-meta\">\n          \n          <span class=\"pt-review-link pt-review-kids\" data-tooltip=\"Identifying this unlocks: Salt Guild\"><i class=\"fa-solid fa-key\"></i> unlocks Salt Guild</span>\n          <span>1 facts</span>\n          <span>1 carriers</span>\n          <span>modified <span class=\"pt-review-time\" data-tooltip=\"1970-01-01T00:00:00.002Z\">1/1/1970, 12:00:00 AM</span></span>\n          <span class=\"pt-review-badge pt-review-ok\" data-tooltip=\"Signed off 1/1/1970, 12:00:00 AM\"><i class=\"fa-solid fa-check\"></i> Reviewed</span></span>\n      </span>\n      <button type=\"button\" class=\"pt-textbtn pt-review-quiet\" data-act=\"unreview\" data-tooltip=\"Withdraw your sign-off — moves it back to the top\">Mark unreviewed</button>\n      <i class=\"fa-solid fa-chevron-down pt-review-caret\"></i>\n    </div></li></ul>\n      <p class=\"pt-empty pt-review-nomatch\" hidden></p>\n    </div>"
