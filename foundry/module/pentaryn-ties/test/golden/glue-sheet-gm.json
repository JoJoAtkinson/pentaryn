                "group": "primary"
              },
              "innerHTML": "<div class=\"pentaryn-ties\" data-actor-id=\"zzPc000000000001\">\n    \n    <ul class=\"pt-list\"><li class=\"pt-empty\">No ties recorded.</li></ul>\n    \n    <div class=\"pt-add-bar\">\n        <button type=\"button\" class=\"pt-add-btn\" data-action=\"add\">\n          <i class=\"fa-solid fa-plus\"></i> Add\n        </button>\n        <span class=\"pt-add-hint\">or hover someone on the map and press 6</span>\n      </div>\n    <div class=\"pt-inbound-head\">\n        <span class=\"pt-inbound-title\">On their sheets only</span>\n        <span class=\"pt-gm-badge\"><i class=\"fa-solid fa-eye-slash\" aria-hidden=\"true\"></i> GM only</span>\n      </div>\n      <p class=\"pt-inbound-hint\">People who have written this character down without being written down back. This section is never shown to a player — to let one see a connection, write it on their own character&#39;s sheet.</p>\n      <ul class=\"pt-list pt-list-inbound\">\n        <li class=\"pt-row pt-inbound\" data-id=\"zzNpc00000000001\" data-inbound=\"1\">\n    <div class=\"pt-summary\" role=\"button\" tabindex=\"0\" aria-expanded=\"false\" data-action=\"toggle\"\n         aria-label=\"ZZ Brakka — recorded on their sheet, not on this one\"\n         data-tooltip=\"Written on ZZ Brakka&#39;s sheet. Click to read it.\">\n      <img class=\"pt-portrait\" src=\"icons/zz/zzNpc00000000001.webp\" alt=\"\" loading=\"lazy\" />\n      <span class=\"pt-who\"><span class=\"pt-name\">ZZ Brakka</span><span class=\"pt-note-preview pt-note-none\"><em>Nothing written on this tie yet.</em></span></span>\n      <span class=\"pt-word pt-wary\">debtor</span>\n      <span class=\"pt-chip\" data-tooltip=\"Wary\"><span class=\"pt-dot pt-wary\"></span><span class=\"pt-chip-label\">Wary</span></span>\n      <span class=\"pt-pips\" role=\"group\" aria-label=\"Strength 4 of 5 — orders this list\" data-tooltip=\"Strength 4 of 5 — orders this list\"><span class=\"pt-pip fill\"></span><span class=\"pt-pip fill\"></span><span class=\"pt-pip fill\"></span><span class=\"pt-pip fill\"></span><span class=\"pt-pip\"></span></span>\n      <span class=\"pt-hint\" aria-hidden=\"true\"><i class=\"fa-solid fa-reply\"></i></span>\n    </div>\n    <div class=\"pt-detail-wrap\" hidden>\n      <div class=\"pt-detail\">\n        <div class=\"pt-notes-prose pt-note-none\"><em>Nothing written on this tie yet.</em></div>\n        <div class=\"pt-detail-actions\">\n          <button type=\"button\" class=\"pt-textbtn\" data-action=\"open\" data-id=\"zzNpc00000000001\">\n            <i class=\"fa-solid fa-arrow-up-right-from-square\"></i> Open ZZ Brakka&#39;s sheet\n          </button>\n          <button type=\"button\" class=\"pt-textbtn\" data-action=\"edit-theirs\" data-id=\"zzNpc00000000001\">\n            <i class=\"fa-solid fa-pen\"></i> Edit ZZ Brakka&#39;s side\n          </button>\n        </div>\n      </div>\n    </div>\n  </li>\n      </ul>\n    <section class=\"pt-authoring\">\n    <div class=\"pt-inbound-head\">\n      <span class=\"pt-inbound-title\">Authoring</span>\n      <span class=\"pt-gm-badge\"><i class=\"fa-solid fa-eye-slash\" aria-hidden=\"true\"></i> GM only</span>\n    </div>\n    <div class=\"pt-kind-picker\">\n    <label class=\"pt-field\">\n      <span class=\"pt-field-label\">Kind</span>\n      <select data-action=\"set-kind\">\n        <option value=\"\" selected>ZZ Caven is its own kind</option>\n        \n        <optgroup label=\"Every other NPC\"><option value=\"zzNpc00000000001\">ZZ Brakka</option><option value=\"zzNpc00000000002\">ZZ Quill</option></optgroup>\n      </select>\n    </label>\n    <p class=\"pt-hint\">Studying this creature reads its own stat block. Point it at another actor to share one bestiary page across every copy.</p>\n  </div>\n    <section class=\"pt-lore-editor\" data-lore-key=\"lore:zzPc000000000001\">\n    <div class=\"pt-group-head\" role=\"heading\" aria-level=\"3\">\n      <span class=\"pt-group-title\">What a check can reveal</span>\n    </div>\n    <p class=\"pt-hint pt-lore-warning\">Everything you write here reaches every client. Nothing goes in a row that would ruin the game if read with devtools.</p>\n    <p class=\"pt-empty\">No rows yet. Add one and give it a name, a skill and a DC.</p>\n    <div class=\"pt-add-bar\">\n      <button type=\"button\" class=\"pt-add-btn\" data-action=\"lore-add\">\n        <i class=\"fa-solid fa-plus\"></i> Add a fact\n      </button>\n    </div>\n  </section>\n    <div class=\"pt-group-head\" role=\"heading\" aria-level=\"3\">\n      <span class=\"pt-group-title\">What they believe</span>\n    </div>\n    <p class=\"pt-hint\">Exactly what each character was told, kept so you do not have to remember it mid-scene. Held rolls wait here until you deliver them.</p>\n    <p class=\"pt-empty\">Nobody has studied this one yet.</p>\n  </section>\n  </div>"
            },
            {
              "tag": "SECTION",
              "className": "tab",
              "dataset": {
                "tab": "known",
                "group": "primary"
              },
              "innerHTML": "<div class=\"pentaryn-ties pentaryn-known\" data-actor-id=\"zzPc000000000001\">\n    <p class=\"pt-known-intro\">What this character knows about the people and creatures they have met — in their own words. Written here, kept here.</p>\n    <ul class=\"pt-list\"><li class=\"pt-empty\">Nothing written down yet. Add someone you have met, then write what you know about them.</li></ul>\n    <div class=\"pt-add-bar\">\n        <button type=\"button\" class=\"pt-add-btn\" data-action=\"known-add\">\n          <i class=\"fa-solid fa-plus\"></i> Add…\n        </button>\n        <span class=\"pt-add-hint\">anyone this character could have met — or hover them on the map and press 5</span>\n      </div>\n    \n  </div>"
            },
            {
              "tag": "SECTION",
              "className": "tab",
              "dataset": {
                "tab": "attributes",
                "group": "primary"
              },
              "innerHTML": "<div class=\"pentaryn-ties pentaryn-attributes\" data-actor-id=\"zzPc000000000001\">\n    \n    <p class=\"pt-hint\">What this one belongs to. Some are worked out from the stat block; the rest you link yourself. Lore you write here is shared by every carrier.</p>\n    <p class=\"pt-empty\">Nothing yet.</p>\n    <div class=\"pt-add-bar pt-attr-add\">\n        <input type=\"search\" class=\"pt-attr-search\" placeholder=\"Link an attribute, or type a new name…\"\n               aria-label=\"Link an attribute, or type a new name…\">\n        <div class=\"pt-attr-results\" hidden></div>\n      </div>\n    <div class=\"pt-world\" data-character=\"zzPc000000000001\">\n    <div class=\"pt-group-head\" role=\"heading\" aria-level=\"3\">\n      <span class=\"pt-group-title\">What you know of the world</span>\n    </div>\n    <p class=\"pt-hint\">Everything in the world, as this character sees it. Marked rows are things they have not been told — open a place to find what sits under it.</p>\n    <div class=\"pt-world-filter\" role=\"group\" aria-label=\"Filter the world tree\">\n        <button type=\"button\" class=\"pt-filter-chip pt-filter-chip-on\"\n                    data-action=\"world-filter\" data-filter=\"all\">All</button><button type=\"button\" class=\"pt-filter-chip\"\n                    data-action=\"world-filter\" data-filter=\"unknown\">Not told</button><button type=\"button\" class=\"pt-filter-chip\"\n                    data-action=\"world-filter\" data-filter=\"pending\">Waiting on you</button><button type=\"button\" class=\"pt-filter-chip\"\n                    data-action=\"world-filter\" data-filter=\"failed\">Missed it</button>\n        <button type=\"button\" class=\"pt-filter-chip pt-filter-chip-quiet\" data-action=\"world-collapse\">Collapse all</button>\n        <button type=\"button\" class=\"pt-filter-chip pt-filter-chip-quiet\" data-action=\"world-expand\">Expand all</button>\n      </div>\n    <p class=\"pt-empty\">Nothing yet. Look people over and you will start to piece the world together.</p>\n    <div class=\"pt-add-bar pt-attr-add pt-grant-control\" data-character=\"zzPc000000000001\">\n    <div class=\"pt-inbound-head\">\n      <span class=\"pt-inbound-title\">Tell them about something</span>\n      <span class=\"pt-gm-badge\"><i class=\"fa-solid fa-eye-slash\" aria-hidden=\"true\"></i> GM only</span>\n    </div>\n    <input type=\"search\" class=\"pt-attr-search pt-grant-search\"\n           placeholder=\"Something they have learned, or a new name to create…\"\n           aria-label=\"Something they have learned, or a new name to create…\">\n    <label class=\"pt-field pt-field-check\">\n      <input type=\"checkbox\" class=\"pt-grant-parents\">\n      <span>Also tell them everything it belongs to</span>\n    </label>\n    <p class=\"pt-hint\">Off by default: they get exactly what you name. Told about a guild but not its city, they know it exists and still cannot spot a member — turn this on when you meant them to start recognising people.</p>\n    <div class=\"pt-attr-results pt-grant-results\" hidden></div>\n  </div>\n  </div>\n  </div>"
            }
          ]
        }
      ]
    }
