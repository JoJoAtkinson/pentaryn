n></select>\n      </label>\n      <span class=\"pt-field\">\n        <span class=\"pt-field-label\">Strength</span>\n        <span class=\"pt-pips\" role=\"group\" aria-label=\"Strength 4 of 5 — orders this list\" data-tooltip=\"Strength 4 of 5 — orders this list\"><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"1\"\n          aria-label=\"Set strength to 1 of 5\" data-tooltip=\"Set strength to 1 of 5\"></button><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"2\"\n          aria-label=\"Set strength to 2 of 5\" data-tooltip=\"Set strength to 2 of 5\"></button><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"3\"\n          aria-label=\"Set strength to 3 of 5\" data-tooltip=\"Set strength to 3 of 5\"></button><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"4\"\n          aria-label=\"Set strength to 4 of 5\" data-tooltip=\"Set strength to 4 of 5\"></button><button type=\"button\" class=\"pt-pip\" data-action=\"strength\" data-n=\"5\"\n          aria-label=\"Set strength to 5 of 5\" data-tooltip=\"Set strength to 5 of 5\"></button></span>\n      </span>\n    </div>\n    <label class=\"pt-field pt-field-notes\">\n      <span class=\"pt-field-label\">Notes — yours, on your side of this tie</span>\n      <textarea class=\"pt-notes-text\" data-field=\"notes\" rows=\"5\" maxlength=\"4000\"\n                placeholder=\"The long version — how they met, what is owed, what is not said in front of ZZ Caven. Only ever visible here.\"></textarea>\n    </label>\n    <div class=\"pt-detail-actions\">\n      <button type=\"button\" class=\"pt-textbtn\" data-action=\"open\" data-id=\"zzPc000000000001\">\n        <i class=\"fa-solid fa-arrow-up-right-from-square\"></i> Open their sheet\n      </button>\n      <button type=\"button\" class=\"pt-textbtn pt-del\" data-action=\"remove\" data-id=\"zzPc000000000001\">\n        <i class=\"fa-solid fa-trash\"></i> Remove this tie\n      </button>\n    </div>\n    \n  </div></div>\n  </li></ul>\n    \n    <div class=\"pt-add-bar\">\n        <button type=\"button\" class=\"pt-add-btn\" data-action=\"add\">\n          <i class=\"fa-solid fa-plus\"></i> Add\n        </button>\n        <span class=\"pt-add-hint\">or hover someone on the map and press 6</span>\n      </div>\n    \n    <section class=\"pt-authoring\">\n    <div class=\"pt-inbound-head\">\n      <span class=\"pt-inbound-title\">Authoring</span>\n      <span class=\"pt-gm-badge\"><i class=\"fa-solid fa-eye-slash\" aria-hidden=\"true\"></i> GM only</span>\n    </div>\n    <div class=\"pt-kind-picker\">\n    <label class=\"pt-field\">\n      <span class=\"pt-field-label\">Kind</span>\n      <select data-action=\"set-kind\">\n        <option value=\"\" selected>ZZ Brakka is its own kind</option>\n        \n        <optgroup label=\"Every other NPC\"><option value=\"zzNpc00000000002\">ZZ Quill</option></optgroup>\n      </select>\n    </label>\n    <p class=\"pt-hint\">Studying this creature reads its own stat block. Point it at another actor to share one bestiary page across every copy.</p>\n  </div>\n    <section class=\"pt-lore-editor\" data-lore-key=\"lore:zzNpc00000000001\">\n    <div class=\"pt-group-head\" role=\"heading\" aria-level=\"3\">\n      <span class=\"pt-group-title\">What a check can reveal</span>\n    </div>\n    <p class=\"pt-hint pt-lore-warning\">Everything you write here reaches every client. Nothing goes in a row that would ruin the game if read with devtools.</p>\n    <p class=\"pt-empty\">No rows yet. Add one and give it a name, a skill and a DC.</p>\n    <div class=\"pt-add-bar\">\n      <button type=\"button\" class=\"pt-add-btn\" data-action=\"lore-add\">\n        <i class=\"fa-solid fa-plus\"></i> Add a fact\n      </button>\n    </div>\n  </section>\n    <div class=\"pt-group-head\" role=\"heading\" aria-level=\"3\">\n      <span class=\"pt-group-title\">What they believe</span>\n    </div>\n    <p class=\"pt-hint\">Exactly what each character was told, kept so you do not have to remember it mid-scene. Held rolls wait here until you deliver them.</p>\n    <p class=\"pt-empty\">Nobody has studied this one yet.</p>\n  </section>\n  </div>"
