{
  "title": "Record a tie",
  "source": "zzPc000000000001",
  "target": "zzNpc00000000001",
  "html": "<div class=\"pt-dlg\">\n      <div class=\"pt-dlg-pair\">\n        <span class=\"pt-dlg-side\">\n          <img class=\"pt-portrait\" src=\"icons/zz/zzPc000000000001.webp\" alt=\"\" />\n          <span class=\"pt-dlg-side-label\">From</span>\n          <a class=\"pt-dlg-fixed pt-dlg-link\" data-action=\"open\" data-id=\"zzPc000000000001\"\n               data-tooltip=\"Open their sheet\" role=\"link\" tabindex=\"0\">ZZ Caven</a>\n        </span>\n        <span class=\"pt-dlg-arrow\" aria-hidden=\"true\"><i class=\"fa-solid fa-arrow-right\"></i></span>\n        <span class=\"pt-dlg-side\">\n          <img class=\"pt-portrait\" src=\"icons/zz/zzNpc00000000001.webp\" alt=\"\" />\n          <span class=\"pt-dlg-side-label\">To</span>\n          <a class=\"pt-dlg-fixed pt-dlg-link\" data-action=\"open\" data-id=\"zzNpc00000000001\"\n             data-tooltip=\"Open their sheet\" role=\"link\" tabindex=\"0\">Token zzTokNpc00000001</a>\n        </span>\n      </div>\n\n      <p class=\"pt-dlg-note\">Editing what ZZ Caven is to Token zzTokNpc00000001.</p>\n\n      <div class=\"pt-fields\">\n        <label class=\"pt-field\">\n          <span class=\"pt-field-label\">One word — what this character is to Token zzTokNpc00000001</span>\n          <input type=\"text\" class=\"pt-dlg-word\" data-field=\"word\" value=\"debtor\"\n                 placeholder=\"one word — sister, rival, client…\" />\n        </label>\n        \n        <label class=\"pt-field\">\n          <span class=\"pt-field-label\">Stance</span>\n          <select class=\"pt-stance\" data-field=\"stance\"><option value=\"2\">Devoted</option><option value=\"1\">Friendly</option><option value=\"0\">Neutral</option><option value=\"-1\" selected>Wary</option><option value=\"-2\">Hostile</option></select>\n        </label>\n        <span class=\"pt-field\">\n          <span class=\"pt-field-label\">Strength</span>\n          <span class=\"pt-dlg-strength\" data-strength=\"4\"><span class=\"pt-pips\" role=\"group\" aria-label=\"Strength 4 of 5 — orders this list\" data-tooltip=\"Strength 4 of 5 — orders this list\"><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"1\"\n          aria-label=\"Set strength to 1 of 5\" data-tooltip=\"Set strength to 1 of 5\"></button><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"2\"\n          aria-label=\"Set strength to 2 of 5\" data-tooltip=\"Set strength to 2 of 5\"></button><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"3\"\n          aria-label=\"Set strength to 3 of 5\" data-tooltip=\"Set strength to 3 of 5\"></button><button type=\"button\" class=\"pt-pip fill\" data-action=\"strength\" data-n=\"4\"\n          aria-label=\"Set strength to 4 of 5\" data-tooltip=\"Set strength to 4 of 5\"></button><button type=\"button\" class=\"pt-pip\" data-action=\"strength\" data-n=\"5\"\n          aria-label=\"Set strength to 5 of 5\" data-tooltip=\"Set strength to 5 of 5\"></button></span></span>\n        </span>\n      </div>\n\n      <label class=\"pt-field pt-field-notes\">\n        <span class=\"pt-field-label\">Notes — yours, on your side of this tie</span>\n        <textarea class=\"pt-dlg-notes\" data-field=\"notes\" rows=\"5\" maxlength=\"4000\"\n                  placeholder=\"The long version — how they met, what is owed, what is not said in front of Token zzTokNpc00000001. Only ever visible here.\">Owes forty.</textarea>\n      </label>\n\n      \n\n      <div class=\"pt-dlg-actions\">\n        <button type=\"button\" class=\"pt-dlg-save\"><i class=\"fa-solid fa-check\"></i> Save</button>\n        <button type=\"button\" class=\"pt-dlg-cancel\">Cancel</button>\n      </div>\n    </div>"
}
