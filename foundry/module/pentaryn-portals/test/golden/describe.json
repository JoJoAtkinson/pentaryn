{
  "module": "pentaryn-portals",
  "namespace": "portals",
  "contract": "pentaryn-portals/api@1",
  "flagScope": "pentaryn-portals",
  "methods": [
    {
      "path": "snapshot",
      "params": [
        {
          "name": "regionOrUuid",
          "type": "RegionDocument|uuid"
        },
        {
          "name": "opts",
          "type": "{ squaresWide = 8, squaresHigh = 5 }",
          "optional": true
        }
      ],
      "returns": "the saved image path | null (not a GM, or the scene has no background)",
      "gm": true,
      "writes": true,
      "query": false,
      "sideEffects": [
        "flags.pentaryn-portals.img",
        "Data: assets/tokens/custom/portals/<sceneId>-<regionId>.webp"
      ],
      "legacy": true,
      "doc": "Crop the region's scene background around it (in grid squares), upload it and make it the card image."
    },
    {
      "path": "cardFor",
      "params": [
        {
          "name": "region",
          "type": "RegionDocument",
          "doc": "a destination region document"
        }
      ],
      "returns": "{ uuid, title, img, description }",
      "gm": false,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "legacy": true,
      "doc": "The card a player sees for this destination, with fallbacks (scene nav name, scene thumbnail). Throws a TypeError for a missing region."
    },
    {
      "path": "teleportParty",
      "params": [
        {
          "name": "destRegion",
          "type": "RegionDocument",
          "doc": "where the party lands (its centre)"
        },
        {
          "name": "opts",
          "type": "{ confirm = true }",
          "optional": true,
          "doc": "confirm: false skips the GM's confirm dialog"
        }
      ],
      "returns": "undefined",
      "gm": true,
      "writes": true,
      "query": false,
      "sideEffects": [
        "Token: update (same scene) or create + delete (another scene)",
        "pulls active players to the destination"
      ],
      "legacy": true,
      "doc": "Move the party on canvas.scene (PCs, their summons, player-owned tokens) to the region. Opens a confirm dialog first unless the setting confirmPartyTeleport is off — a console or bridge caller passes { confirm: false }."
    },
    {
      "path": "lookAt",
      "params": [
        {
          "name": "destRegion",
          "type": "RegionDocument"
        }
      ],
      "returns": "undefined",
      "gm": true,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "legacy": true,
      "doc": "Pan the calling GM's own view to the region (switching scene if needed). Nobody moves; nothing broadcasts."
    },
    {
      "path": "spreadArrival",
      "params": [
        {
          "name": "tokenDoc",
          "type": "TokenDocument",
          "doc": "a token that just arrived"
        }
      ],
      "returns": "the same TokenDocument",
      "gm": true,
      "writes": true,
      "query": false,
      "sideEffects": [
        "Token: x, y (teleport, no animation)"
      ],
      "legacy": true,
      "doc": "If the token shares a square with someone, move it to the nearest free square (setting spreadArrivals)."
    },
    {
      "path": "open",
      "params": [
        {
          "name": "region",
          "type": "RegionDocument",
          "doc": "a destination region document"
        },
        {
          "name": "opts",
          "type": "{ edit = false }",
          "optional": true
        }
      ],
      "returns": "Promise<PortalCard> | null (not a GM)",
      "gm": true,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "legacy": true,
      "doc": "Open the Portal card window for a teleport region: the player's view, or the editor with { edit: true }."
    },
    {
      "path": "redraw",
      "params": [],
      "returns": "Promise<void>",
      "gm": false,
      "writes": false,
      "query": false,
      "sideEffects": [],
      "legacy": true,
      "doc": "Redraw the travel badges on this client's canvas."
    }
  ],
  "queries": [],
  "settings": [
    {
      "key": "teleportDefault",
      "scope": "world",
      "type": "Boolean",
      "default": true,
      "doc": "Core's teleport confirm opens with Teleport focused instead of Don't Teleport (Esc and the X still decline)."
    },
    {
      "key": "spreadArrivals",
      "scope": "world",
      "type": "Boolean",
      "default": true,
      "doc": "The active GM moves a PC that arrives through a portal onto an occupied square to the nearest free one."
    },
    {
      "key": "confirmPartyTeleport",
      "scope": "world",
      "type": "Boolean",
      "default": true,
      "doc": "teleportParty asks first, listing who moves; an API caller passes { confirm: false } to skip the dialog."
    }
  ],
  "events": [],
  "hooks": [
    {
      "name": "deleteToken",
      "label": "summons follow"
    },
    {
      "name": "createRegion",
      "label": "badges redraw"
    },
    {
      "name": "updateRegion",
      "label": "badges redraw"
    },
    {
      "name": "deleteRegion",
      "label": "badges redraw"
    },
    {
      "name": "createRegionBehavior",
      "label": "badges redraw"
    },
    {
      "name": "updateRegionBehavior",
      "label": "badges redraw"
    },
    {
      "name": "deleteRegionBehavior",
      "label": "badges redraw"
    },
    {
      "name": "canvasReady",
      "label": "badges draw"
    },
    {
      "name": "sightRefresh",
      "label": "badges sight"
    },
    {
      "name": "canvasTearDown",
      "label": "badges teardown"
    },
    {
      "name": "renderDialogV2",
      "label": "teleport dialog cards"
    },
    {
      "name": "renderRegionConfig",
      "label": "region config card"
    }
  ],
  "patches": [],
  "flags": {
    "writes": [
      "flags.pentaryn-portals.title",
      "flags.pentaryn-portals.img",
      "flags.pentaryn-portals.description"
    ],
    "reads": [
      "flags.pentaryn.travel.regionId",
      "flags.pentaryn-aoe.handle",
      "flags.pentaryn-aoe.handleActor",
      "flags.dnd5e.summon.origin",
      "flags.dnd5e.isPolymorphed"
    ]
  },
  "errors": [
    "NOT_GM",
    "NO_GM",
    "NOT_READY",
    "NOT_FOUND",
    "AMBIGUOUS",
    "BAD_ARGS",
    "REFUSED",
    "CONFLICT",
    "UNSUPPORTED",
    "TIMEOUT",
    "INTERNAL"
  ]
}
