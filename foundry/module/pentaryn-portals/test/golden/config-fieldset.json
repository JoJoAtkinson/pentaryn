"<fieldset class=\"pp-config\">\n    <legend>Portal card</legend>\n    <p class=\"hint\">Shown to a player choosing to travel <em>here</em> from a linked teleport region.</p>\n    <div class=\"form-group\"><label>Title</label>\n      <div class=\"form-fields\"><input type=\"text\" name=\"flags.pentaryn-portals.title\" value=\" The Fighting Pit \" placeholder=\"The Fighting Pit\"></div></div>\n    <div class=\"form-group\"><label>Image</label>\n      <div class=\"form-fields\"><input type=\"text\" name=\"flags.pentaryn-portals.img\" value=\"cards/pit.webp?v=abc\" placeholder=\"scene thumbnail\">\n      <button type=\"button\" class=\"pp-snap\" data-tooltip=\"Crop the map art around this region and use it\"><i class=\"fa-solid fa-camera\"></i></button></div></div>\n    <div class=\"form-group stacked\"><label>Description</label>\n      <textarea name=\"flags.pentaryn-portals.description\" rows=\"4\" placeholder=\"What players read before they choose.\">Sand, &lt;script&gt;alert(1)&lt;/script&gt;\nand cheering.</textarea></div>\n    <div class=\"pp-preview\"><div class=\"pp-card\"><img class=\"pp-thumb\" src=\"cards/pit.webp?v=abc\" alt>\n    <div class=\"pp-text\"><h4>The Fighting Pit</h4><p class=\"pp-desc\">Sand, &lt;script&gt;alert(1)&lt;/script&gt;<br>and cheering.</p></div></div></div></fieldset>"
