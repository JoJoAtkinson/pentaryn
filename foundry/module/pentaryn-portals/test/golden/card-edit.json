{
  "content": "<section class=\"ppt-passage\">\n      <input class=\"ppt-name\" type=\"text\" data-set=\"name\" value=\"Fork\" data-tooltip=\"Passage name (GM only)\">\n      <div class=\"ppt-switches\">\n        <label class=\"ppt-switch\" data-tooltip=\"Off = sealed: players can't see the badge or use it\">\n      <input type=\"checkbox\" data-set=\"open\" checked><span class=\"ppt-slider\"></span><span>Open</span></label>\n        <label class=\"ppt-switch\" data-tooltip=\"Off = players see '?' and 'a way onward'\">\n      <input type=\"checkbox\" data-set=\"revealed\" checked><span class=\"ppt-slider\"></span><span>Show where it leads</span></label>\n        <label class=\"ppt-switch\" data-tooltip=\"Off = stepping on it moves them at once\">\n      <input type=\"checkbox\" data-set=\"choice\" checked><span class=\"ppt-slider\"></span><span>Ask before moving</span></label>\n      </div>\n      <p class=\"hint\"><i class=\"fa-solid fa-up-down-left-right\"></i> Drag this passage's badge on the map to move it. Each card below is the place it leads to.</p>\n    </section><div class=\"ppt-cards\"><article class=\"ppt-card ppt-editcard\" data-uuid=\"Scene.ScnPit.Region.RegPit\">\n        <figure class=\"ppt-imgedit\">\n          <img class=\"ppt-thumb\" src=\"cards/pit.webp?v=abc\" alt>\n          <div class=\"ppt-imgtools\">\n            <button type=\"button\" data-act=\"pick\" data-tooltip=\"Choose an image\"><i class=\"fa-solid fa-folder-open\"></i></button>\n            <button type=\"button\" data-act=\"snap\" data-tooltip=\"Snap it from the map around that spot\"><i class=\"fa-solid fa-camera\"></i></button>\n            <button type=\"button\" data-act=\"clearimg\" data-tooltip=\"Back to the scene thumbnail\"><i class=\"fa-solid fa-rotate-left\"></i></button>\n          </div>\n        </figure>\n        <div class=\"ppt-text\">\n          <input class=\"ppt-title\" type=\"text\" data-f=\"title\" value=\" The Fighting Pit \" placeholder=\"The Fighting Pit\">\n          <textarea class=\"ppt-descedit\" data-f=\"description\" rows=\"5\" placeholder=\"What players read before they choose…\">Sand, &lt;script&gt;alert(1)&lt;/script&gt;\nand cheering.</textarea>\n          <div class=\"ppt-meta\"><i class=\"fa-solid fa-location-dot\"></i> Drow City — Fighting Pit (set-piece) · Pit gate\n            <a data-act=\"look\" data-tooltip=\"Look there (only you)\"><i class=\"fa-solid fa-binoculars\"></i></a>\n            <a data-act=\"unlink\" data-tooltip=\"Remove this destination\"><i class=\"fa-solid fa-link-slash\"></i></a></div>\n        </div>\n      </article><article class=\"ppt-card ppt-editcard\" data-uuid=\"Scene.ScnPrison.Region.RegCell\">\n        <figure class=\"ppt-imgedit\">\n          <img class=\"ppt-thumb\" src=\"icons/svg/door-exit.svg\" alt>\n          <div class=\"ppt-imgtools\">\n            <button type=\"button\" data-act=\"pick\" data-tooltip=\"Choose an image\"><i class=\"fa-solid fa-folder-open\"></i></button>\n            <button type=\"button\" data-act=\"snap\" data-tooltip=\"Snap it from the map around that spot\"><i class=\"fa-solid fa-camera\"></i></button>\n            \n          </div>\n        </figure>\n        <div class=\"ppt-text\">\n          <input class=\"ppt-title\" type=\"text\" data-f=\"title\" value placeholder=\"Drow Prison\">\n          <textarea class=\"ppt-descedit\" data-f=\"description\" rows=\"5\" placeholder=\"What players read before they choose…\"></textarea>\n          <div class=\"ppt-meta\"><i class=\"fa-solid fa-location-dot\"></i> Drow Prison · Cell\n            <a data-act=\"look\" data-tooltip=\"Look there (only you)\"><i class=\"fa-solid fa-binoculars\"></i></a>\n            <a data-act=\"unlink\" data-tooltip=\"Remove this destination\"><i class=\"fa-solid fa-link-slash\"></i></a></div>\n        </div>\n      </article></div><section class=\"ppt-add\">\n      <select data-act=\"addsel\"><option value>Add a destination…</option><option value=\"Scene.ScnPit.Region.RegStair\">Drow City — Fighting Pit (set-piece) — Stair</option><option value=\"Scene.ScnPrison.Region.RegPassage\">Drow Prison — Passage → Pit</option><option value=\"Scene.ScnPrison.Region.RegSecret\">Drow Prison — Secret</option></select>\n      <label class=\"ppt-switch\" data-tooltip=\"Also make that spot lead back here\"><input type=\"checkbox\" data-act=\"twoway\" checked><span class=\"ppt-slider\"></span><span>Two-way</span></label>\n    </section>",
  "toggle": "<label class=\"ppt-toggle\" data-tooltip=\"Toggle edit mode\"><input type=\"checkbox\" checked><span class=\"ppt-slider\"></span></label>"
}
