# ~/.config/pentaryn/env — this machine's identity for the pentaryn tooling.
#
# Copy to ~/.config/pentaryn/env (or $PENTARYN_ENV_FILE) and set what differs from the
# defaults. KEY=value lines, # comments. The real environment always wins over this file.
# Never put a secret here: rclone reads its own config, Infisical holds the rest.
# Design: context/plans/rclone-two-hosts-2026-10.md §2.

# This machine's tag in snapshot names. [a-z0-9-], 1-32 chars; not untagged/latest/local.
# Default: `mac` on macOS (so the Mac is the primary with no configuration), else the
# sanitised `hostname -s`. `make foundry-cloud` notes when a default is in use.
PENTARYN_HOST=mac

# The one value that must agree on both machines. Default: mac.
PENTARYN_PRIMARY_HOST=mac

# Environment only, per run, never here: PENTARYN_ROLE_OVERRIDE=primary lets the tunnel and
# the updater run on the alt. Listed so the key set is complete.
#PENTARYN_ROLE_OVERRIDE=

# Foundry's data ROOT (holds Config/ Data/ Logs/), not Data/ itself.
# Default: Mac ~/Library/Application Support/FoundryVTT · Linux ~/.local/share/FoundryVTT
#FOUNDRY_DATA=

# Foundry's app payload (holds package.json and main.js).
# Default: Mac /Applications/Foundry Virtual Tabletop.app/Contents/Resources/app
#          Linux ~/foundryvtt/resources/app
#FOUNDRY_APP_ROOT=

# Default: 30000
#FOUNDRY_PORT=30000

# Where the cloud is. Unset: rclone `onedrive:DnD/foundry` when that remote exists, else the
# Mac OneDrive folder. `name:path` → rclone; a path → a plain folder; mac-folder → the Mac
# OneDrive folder even when rclone is configured.
#PENTARYN_CLOUD=onedrive:DnD/foundry

# The rclone binary. Default: `which rclone`, then /opt/homebrew/bin, /usr/local/bin.
#PENTARYN_RCLONE=

# How many of THIS host's rolling snapshots to keep. Default: 10.
#PENTARYN_KEEP_SNAPSHOTS=10

# Linux only: how to start/stop Foundry (run with bash -c; must return promptly and leave
# Foundry listening on FOUNDRY_PORT). Unset: a detached `node main.js` (dies with WSL).
#PENTARYN_START_CMD=
#PENTARYN_STOP_CMD=
